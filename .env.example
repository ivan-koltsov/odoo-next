# Odoo backend URL (server-side only — never exposed directly to the browser)
ODOO_BASE_URL=http://localhost:8069

# Default Odoo database name
ODOO_DB=odoo

# Optional: request timeout in milliseconds (default: 15000)
ODOO_TIMEOUT_MS=15000

# Optional: customize the HttpOnly session cookie name (default: odoo_session_id)
ODOO_SESSION_COOKIE_NAME=odoo_session_id

# Public app branding
NEXT_PUBLIC_APP_NAME=Odoo Next
