# Production environment variables for docker-compose.prod.yml
# Copy to .env.prod and set a strong POSTGRES_PASSWORD before deploying:
#   cp .env.production.example .env.prod

POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_me_to_a_strong_password

ODOO_DB=odoo
ODOO_TIMEOUT_MS=15000
ODOO_SESSION_COOKIE_NAME=odoo_session_id

# Host ports
WEB_PORT=3000
ODOO_HOST_PORT=8069

NEXT_PUBLIC_APP_NAME=Odoo Next
